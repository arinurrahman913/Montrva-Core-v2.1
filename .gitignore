__pycache__/
*.pyc
.venv/
venv/
*_output.json
dashboard/data/*.json
# Salinan sebelum operasi sekali-jalan atas data tahap (mis.
# scripts/compact_historical.py) — ratusan MB, dan `dashboard/data/*.json` di
# atas tidak menangkapnya karena akhirannya bukan .json.
dashboard/data/*.bak
# Root reference snapshots — regenerated every pipeline run, and at full-market
# scale evidence.json alone is ~275MB (way over GitHub's 100MB file limit).
/evidence.json
/knowledge.json
/peer_results.json
/screening.json
.cache/
.env
frontend/node_modules/
.tools/
logs/
*.log

# Lapisan pribadi (personal layer) -- portofolio, harga beli, dan rekomendasi
# tindakan pribadi. Non-negosiabel, bukan cuma "aman kalau lupa exclude saat
# publish" seperti dashboard/data/*.json lainnya: holdings.json membocorkan
# portofolio riil kalau sampai ter-commit, bahkan di repo privat sekalipun.
dashboard/data/personal/
